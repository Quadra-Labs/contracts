# Deploy configuration. Copy to `.env` and fill in PRIVATE_KEY.
#
# `forge script` auto-loads `.env` from this directory, so `forge script script/Deploy.s.sol
# --rpc-url coston2 --broadcast` picks everything up with no shell exports and no key on a
# command line.
#
# `.env` is gitignored; THIS file is tracked and must never hold a real key.

# --- required -----------------------------------------------------------------------------------

# The deployer. Becomes the owner of all four contracts and the initial SealedCompetition operator,
# so every later privileged call -- setActiveTee, setFee, setIntake, configureFcc -- needs this key.
PRIVATE_KEY=

# Fee recipient AND the address the fresh QUADRA supply is minted to (see QUADRA_TOKEN below), so
# this is what funds every agent and user in a demo. Keep it a key you actually hold.
#
# A zero treasury with a non-zero fee is now rejected outright: it would revert every payout.
TREASURY=0x3C76Ea5F58a76eCf11443Efb1Cf292EC37914949

# The only address allowed to call releasePayment. Zero is rejected by setIntake for the same
# reason -- it would silently brick releases while still reading as a configured role.
INTAKE_ADDRESS=0x3C76Ea5F58a76eCf11443Efb1Cf292EC37914949

# --- the token ------------------------------------------------------------------------------------

# LEAVE THIS UNSET to mint a fresh supply to TREASURY.
#
# Setting it reuses an existing token so balances survive a redeploy, which is the right move ONLY
# when you control that token's supply holder. The 2026-08-05 deployment minted the whole supply to
# 0xE01dcfdfcB48D69bF5Bb017f2d8569c0005cB108, whose key is lost -- every QUADRA ever minted is
# stranded there and nothing was ever distributed, so that token is dead and must NOT be reused.
# QUADRA_TOKEN=

# --- optional -------------------------------------------------------------------------------------

# Platform fee in basis points. 1000 = 10%, which is what the ported Move test pins.
FEE_BPS=1000

# The Confidential Space image digest to pin. Still the placeholder until an image exists --
# see DEPLOYMENT-STATE.md Gap 3.
# EXPECTED_IMAGE_DIGEST=sha256:dev

# Bind a TEE wallet at deploy time. Left unset, the registry ships with no active TEE and
# setActiveTee is a later one-liner. Note setActiveTee now REJECTS the zero address; to retire a
# TEE, point it at an owner-controlled burner instead.
# TEE_WALLET=
# TEE_PUBKEY=0x04

# The oracle verifier is resolved from Flare's contract registry, which is the one address safe to
# hardcode. Override only to point at something else deliberately.
# FTSO_VERIFIER=

# The on-chain vTPM attestation verifier. Zero (default) leaves the dev path as the only way to
# bind a TEE.
# VTPM_VERIFIER=

# true allows a deploy with no oracle verifier and roles defaulted to the deployer. Never on a
# real network -- it would quietly make one key both the fee recipient and the release authority.
# DEV=false
